{
  "name": "inselwaechter",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Inselwächter – ein Tower-Defense-Spiel für Browser und Android",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "sim": "node scripts/simulate.mjs",
    "test": "node scripts/test-storage.mjs && node scripts/test-game.mjs",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0"
  }
}
